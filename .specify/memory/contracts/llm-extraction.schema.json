{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "llm-extraction.schema.json",
  "title": "LLM Modification Extraction Response",
  "description": "Schema for the array of modifications returned by the LLM extraction prompt",
  "type": "object",
  "required": ["modifications"],
  "properties": {
    "modifications": {
      "type": "array",
      "description": "All discrete modifications extracted from a single review",
      "items": {
        "$ref": "#/$defs/modificationObject"
      }
    }
  },
  "$defs": {
    "modificationObject": {
      "type": "object",
      "required": ["modification_type", "reasoning", "edits"],
      "properties": {
        "modification_type": {
          "type": "string",
          "enum": [
            "ingredient_substitution",
            "quantity_adjustment",
            "technique_change",
            "addition",
            "removal"
          ],
          "description": "Category of modification"
        },
        "reasoning": {
          "type": "string",
          "minLength": 10,
          "description": "Why this modification improves the recipe"
        },
        "edits": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/modificationEdit" },
          "description": "Atomic edit operations"
        }
      }
    },
    "modificationEdit": {
      "type": "object",
      "required": ["target", "operation", "find"],
      "properties": {
        "target": {
          "type": "string",
          "enum": ["ingredients", "instructions"],
          "description": "Where to apply the edit"
        },
        "operation": {
          "type": "string",
          "enum": ["replace", "add_after", "remove"],
          "default": "replace"
        },
        "find": {
          "type": "string",
          "minLength": 1,
          "description": "Text to find in the recipe"
        },
        "replace": {
          "type": "string",
          "description": "Replacement text (required for replace operation)"
        },
        "add": {
          "type": "string",
          "description": "Text to add (required for add_after operation)"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "operation": { "const": "replace" } } },
          "then": { "required": ["replace"] }
        },
        {
          "if": { "properties": { "operation": { "const": "add_after" } } },
          "then": { "required": ["add"] }
        }
      ]
    }
  }
}
